{
  "name": "music-undercover",
  "version": "0.1.0",
  "private": true,
  "description": "Party game social-deduction inspiré d'Undercover, où l'indice est une musique (lien YouTube) au lieu d'un mot.",
  "scripts": {
    "postinstall": "node scripts/generate-mock-audio.mjs",
    "dev": "tsx watch server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-setup": "node scripts/check-setup.mjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "nanoid": "5.1.16",
    "clsx": "2.1.1",
    "lucide-react": "0.400.0"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.3",
    "tailwindcss": "3.4.19",
    "postcss": "8.5.28",
    "autoprefixer": "10.4.19",
    "tsx": "4.16.2",
    "cross-env": "7.0.3",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}

# ============================================================================
# Music Undercover — variables d'environnement
#
# Bonne nouvelle : ce fichier est presque vide. Le jeu utilise YouTube pour
# les musiques, et YouTube ne demande AUCUNE clé API pour ce dont ce jeu a
# besoin (lecture du lecteur officiel + récupération du titre/artiste via
# l'endpoint public "oEmbed"). Tu peux donc copier ce fichier en .env.local
# et ne RIEN remplir — ça marche directement avec de vrais liens YouTube.
#
#   cp .env.example .env.local          (Mac/Linux)
#   copy .env.example .env.local        (Windows)
#
# .env.local n'est JAMAIS envoyé sur GitHub (il est listé dans .gitignore).
# ============================================================================

# --- Port du serveur (rarement à changer) ----------------------------------
PORT=3000

# --- Origine autorisée pour Socket.io (optionnel) ---------------------------
# Laisse vide en local. En production, mets l'URL publique de ton site,
# ex: https://music-undercover.onrender.com
CLIENT_ORIGIN=
